{
	"compilerOptions": {
		"target": "ES2018",
		"module": "commonjs",
		"outDir": "./out",
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"sourceMap": false,
		"noEmit": true
	},
	"include": ["src/**/*", "tests/**/*"],
	"exclude": ["node_modules"]
}
