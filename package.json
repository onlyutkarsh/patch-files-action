{
  "name": "token-replacement-action",
  "version": "1.0.0",
  "description": "A simple utility action to replace tokens in files",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch && npm run lint",
    "package": "npm run build && npm run lint && npm test && ncc build src/index.ts -o dist",
    "test": "jest --runInBand",
    "test-watch": "jest --watch --runInBand",
    "lint": "eslint -c .eslintrc.js --ext .ts ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlyutkarsh/token-replacement-action.git"
  },
  "keywords": [],
  "author": "onlyutkarsh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/onlyutkarsh/token-replacement-action/issues"
  },
  "homepage": "https://github.com/onlyutkarsh/token-replacement-action#readme",
  "husky": {
    "hooks": {
      "pre-commit": "npm run package"
    }
  },
  "dependencies": {
    "@actions/core": "~1.11.1",
    "@actions/github": "~6.0.0",
    "@actions/glob": "~0.5.0",
    "@vercel/ncc": "^0.34.0",
    "fast-json-patch": "~3.1.1",
    "xml2js": "^0.6.2",
    "xregexp": "~5.1.2"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/node": "~22.15.3",
    "@types/shelljs": "~0.8.15",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "~8.31.0",
    "@typescript-eslint/parser": "~8.31.0",
    "eslint": "~9.25.1",
    "eslint-plugin-prettier": "~5.2.6",
    "husky": "~9.1.7",
    "jest": "~29.7.0",
    "jest-circus": "~29.7.0",
    "ts-jest": "~29.3.2",
    "typescript": "~5.8.3"
  }
}